# FlowSentinel — Wave 3 env template (never commit real secrets)

# SoSoValue OpenAPI (required for live ETF / news / SSI)
# Docs: https://sosovalue-1.gitbook.io/sosovalue-api-doc
# Header used: x-soso-api-key
SOSOVALUE_API_KEY=

# Gemini AI thesis (optional — falls back to deterministic rules)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# SoDEX testnet trading (optional — labelled DRY-RUN when absent)
# Hard-locked to testnet-gw.sodex.dev / chainId 138565. No mainnet path.
# Register a key on YOUR PC with: npx tsx scripts/register-testnet-api-key.ts
# Never put a master wallet key or mainnet key here.
SODEX_ACCOUNT_ID=
SODEX_API_KEY_NAME=
SODEX_API_KEY_PRIVATE_KEY=
# Optional override (must stay testnet):
# SODEX_BASE_URL=https://testnet-gw.sodex.dev



# Optional: force demo labelling even when keys exist
FLOWSENTINEL_DEMO_MODE=0

# Public URL (preview or local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
