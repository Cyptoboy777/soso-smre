# ── SERVER-SIDE SECRETS ─────────────────────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables (and in a local .env.local).
# NEVER prefix them with NEXT_PUBLIC_ and never commit a real .env file (it is git-ignored).

# SoSoValue OpenAPI key (news, ETF flows, sectors). Free key: https://sosovalue.com
SOSOVALUE_API_KEY=

# AI assistant (any OpenAI-compatible provider). If AI_API_KEY is empty,
# /api/assistant uses GEMINI_API_KEY against Gemini's OpenAI-compatible endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Google Gemini for the Skills tab (AI explanations, market brief, news impact, plan review).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Builder code (SoDEX builder program / buildsoso.xyz): this is what earns the app points.
# NEXT_PUBLIC_BUILDER_ID = your SoDEX account ID (the "builder ID"). The account must hold >= 100 vUSDC in BOTH spot and perps.
# NEXT_PUBLIC_BUILDER_FEE = fee you request per fill in tenths of a basis point (10 = 1 bp = 0.01%, spot max 2000).
# These are public by design (they appear in every signed order), not secrets. Leave BUILDER_ID empty to disable.
NEXT_PUBLIC_BUILDER_ID=
NEXT_PUBLIC_BUILDER_FEE=10

# WalletConnect (phone wallets + QR). Free project id from https://cloud.reown.com . Public by design. Leave empty to hide the option.
NEXT_PUBLIC_WC_PROJECT_ID=

# ── OPTIONAL ────────────────────────────────────────────────────────
# Set to 1 to make the browser call the SoDEX gateway directly instead of through /api/sodex
# (only if SoDEX allows your domain via CORS).
# NEXT_PUBLIC_SODEX_DIRECT=1
