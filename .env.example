# FlowSentinel — Wave 3 env template (never commit real secrets)

# SoSoValue OpenAPI (required for live ETF / news / SSI)
# Docs: https://sosovalue-1.gitbook.io/sosovalue-api-doc
# Header used: x-soso-api-key
SOSOVALUE_API_KEY=

# Gemini AI thesis (optional — falls back to deterministic rules)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# SoDEX testnet trading (optional — dry-run when absent)
# Testnet REST: https://testnet-gw.sodex.dev/api/v1/spot
SODEX_API_KEY=
SODEX_API_SECRET=

# Optional: force demo labelling even when keys exist
FLOWSENTINEL_DEMO_MODE=0

# Public URL (preview or local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
